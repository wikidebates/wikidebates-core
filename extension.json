			"i18n/compat"
		]
	},
	"config": {
		"DebatePHPMode": {
			"value": "reference",
			"description": "DebatePHP 0.8.0 renderer: reference or optimized; reference is the default."
		},
		"DebatePHPProfiling": {
			"value": false,
			"description": "Log per-invocation timings and actual preprocessing counts by reason to the DebatePHP debug channel."
		},
		"DebatePHPDiagnostics": {
			"value": false,
			"description": "Log renderer integration diagnostics to the DebatePHP debug channel."
		},
		"DebatePHPHTMLAttributes": {
			"value": null,
			"description": "Optional HTML Tags attribute policy; null uses wgHTMLTagsAttributes or the bundled policy."
		}
	},
	"manifest_version": 2,
	"AuthManagerAutoConfig": {
		"preauth": {
