{
  "name": "DebatePHP",
  "version": "0.7.0",
  "author": "Wikidébats contributors; PHP migration",
  "description": "Native PHP renderers for Debate and Argument, with native tags, forms and bundled translations.",
  "type": "parserhook",
  "requires": {
    "MediaWiki": ">= 1.43.0 < 1.44.0"
  },
  "AutoloadClasses": {
    "MediaWiki\\Extension\\DebatePHP\\MediaWikiContext": "src/MediaWikiContext.php",
    "MediaWiki\\Extension\\DebatePHP\\HtmlBuilder": "src/HtmlBuilder.php",
    "MediaWiki\\Extension\\DebatePHP\\Context": "src/Context.php",
    "MediaWiki\\Extension\\DebatePHP\\ReferenceRenderer": "src/ReferenceRenderer.php",
    "MediaWiki\\Extension\\DebatePHP\\Hooks": "src/Hooks.php",
    "MediaWiki\\Extension\\DebatePHP\\I18n": "src/I18n.php",
    "MediaWiki\\Extension\\DebatePHP\\Table": "src/Table.php",
    "MediaWiki\\Extension\\DebatePHP\\Lua": "src/Lua.php",
    "MediaWiki\\Extension\\DebatePHP\\Renderer": "src/Renderer.php",
    "MediaWiki\\Extension\\DebatePHP\\TextEscaper": "src/TextEscaper.php",
    "MediaWiki\\Extension\\DebatePHP\\Telemetry": "src/Telemetry.php",
    "MediaWiki\\Extension\\DebatePHP\\NativeTags": "src/NativeTags.php",
    "MediaWiki\\Extension\\DebatePHP\\ArgumentContext": "src/ArgumentContext.php",
    "MediaWiki\\Extension\\DebatePHP\\ArgumentReferenceRenderer": "src/ArgumentReferenceRenderer.php",
    "MediaWiki\\Extension\\DebatePHP\\ArgumentRenderer": "src/ArgumentRenderer.php",
    "MediaWiki\\Extension\\DebatePHP\\SerializedData": "src/SerializedData.php"
  },
  "Hooks": {
    "ParserFirstCallInit": "MediaWiki\\Extension\\DebatePHP\\Hooks::onParserFirstCallInit"
  },
  "ExtensionMessagesFiles": {
    "DebatePHPMagic": "DebatePHP.i18n.magic.php"
  },
  "config": {
    "DebatePHPMode": {
      "value": "reference",
      "description": "reference or optimized; validate in staging before production."
    },
    "DebatePHPProfiling": {
      "value": false,
      "description": "Log per-invocation timings and actual preprocessing counts by reason to the private DebatePHP debug channel."
    },
    "DebatePHPDiagnostics": {
      "value": false,
      "description": "Log swallowed SMW/SEO errors without their property values or expanded text."
    },
    "DebatePHPHTMLAttributes": {
      "value": null,
      "description": "Allowed native tag attributes. Null inherits wgHTMLTagsAttributes when present, otherwise uses the a/script defaults."
    }
  },
  "manifest_version": 2,
  "license-name": "GPL-3.0-or-later",
  "MessagesDirs": {
    "DebatePHP": [
      "i18n"
    ]
  }
}
